#!/bin/sh
# KubeOS: the single source of truth for every live-build option.
#
# RUN    sh auto/config        (never `lb config` by hand)
# WHY    `lb config` regenerates everything under config/ that live-build owns
#        (config/bootstrap, config/common, config/chroot, ...), so an option
#        written anywhere else is lost on the next run. Always edit this file.
# NOTE   A POSIX shell cannot carry a comment inside a line-continued command,
#        which is why the groups below are documented here instead of inline.
#
#   apt sources        No apt proxy, and the empty --apt-http-proxy below is
#                      DELIBERATE - do not delete it. The proxy itself was
#                      removed on 2026-11-11: it needed apt-cacher-ng on the build
#                      machine, it cached nothing for the HTTPS repos
#                      (packages.buildkite.com, pkgs.k8s.io - a proxy can only
#                      CONNECT-tunnel those), and it failed the build with
#                      "502 CONNECT error: Cannot allocate memory" when it ran out
#                      of RAM next to a 2 GB chroot (AGENTS.md 14, 16.6 item 1).
#                      WHY THE EMPTY OPTION: `lb config` merges with the config/
#                      files already on disk, so simply dropping the option leaves
#                      the old value in config/common for ever - and live-build
#                      then does `export http_proxy` from it into every chroot apt
#                      call, so the build keeps using the proxy even though this
#                      file no longer mentions one. An explicit empty value is the
#                      only way to unset it. Verify after `sh auto/config` with:
#                          grep LB_APT_HTTP_PROXY config/common   # -> =""
#                      --security/--updates false: no security archive is used
#                      yet; see AGENTS.md section 7 open decision 2.
#                      archive-areas include non-free and non-free-firmware for
#                      the NIC/GPU firmware a node may need.
#   release            trixie = Debian 13.
#   installer          "live" installs the live root filesystem, and the GTK
#                      frontend is what the KubeOS theme in
#                      config/includes.installer/ dresses.
#   firmware           --firmware-chroot false: live-build has a chroot_firmware
#                      stage that installs EVERY firmware package in the archive
#                      (measured: 832 MiB in 39 packages) no matter what
#                      config/package-lists says. KubeOS ships wired-NIC firmware
#                      explicitly instead (firmware-realtek + firmware-linux-free).
#   live system        boot=live components is required by live-boot;
#                      quiet splash loglevel=3 keeps the boot silent except for
#                      warnings (see AGENTS.md section 14).
#   image identity     --image-name names the FILES that come out of the build
#                      (kubeos-0.1.0-alpha-amd64.iso; live-build appends
#                      -ARCH and, for --binary-image iso-hybrid, ".hybrid.iso" -
#                      tools/rename-iso.sh strips that ".hybrid" infix from
#                      auto/build once the build is done, because --binary-image
#                      iso would drop the MBR that makes the image bootable from
#                      a USB stick. `lb build noauto` skips auto/, so such a
#                      build keeps the ".hybrid" name).
#                      KEEP THE VERSION IN STEP with VERSION_ID= in
#                      config/includes.chroot/etc/os-release (VERSION= carries the
#                      SemVer pre-release suffix, so it is VERSION_ID that matches
#                      the file name: 0.1.0 -> kubeos-0.1.0-alpha).
#                      The --iso-* options set what /dev/cdrom, UDisks and the
#                      ISO9660 label show (that is a separate field: the volume
#                      label keeps the capitalised product name).
#   output             --source false: no extra source ISO is produced.
#   kernel             KubeOS ships its OWN kernel (user decision 2026-11-22), so the
#                      ISO must not install Debian's. live-build decides this with two
#                      options, and the installed package name is their concatenation -
#                      read from the installed live-build, not assumed:
#                          /usr/lib/live/build/chroot_linux-image
#                              echo ${PACKAGE}-${FLAVOUR} >> chroot/root/packages.chroot
#                          /usr/share/live/build/functions/configuration.sh:215-216
#                              --linux-flavours given => used VERBATIM (empty => the arch name)
#                      so --linux-packages "linux-image" + --linux-flavours "kubeos"
#                      installs linux-image-kubeos, the KubeOS flavour meta
#                      (sources: .pkg-staging/kubeos-kernel/) which pins exactly
#                      linux-image-6.12.117-kubeos (= 6.12.117-1kubeos1) from
#                      repo.kubeos.in and conflicts with linux-image-amd64.
#                      The flavour MUST be "kubeos", not the arch: binary_grub_cfg and
#                      binary_syslinux find the kernel by globbing
#                      chroot/boot/vmlinuz-*${FLAVOUR}, and the custom kernel is
#                      vmlinuz-6.12.117-kubeos. Side effect to expect: the BIOS live entry
#                      is labelled "KubeOS Live (kubeos)" because
#                      config/bootloaders/syslinux_common/live.cfg.in prints @FLAVOUR@.
#                      Why the meta instead of the kernel name here: this file then never
#                      changes when the kernel is rebuilt - only the package's Depends and
#                      version move (KERNEL in .pkg-staging/kubeos-kernel records the pin).
#                      --linux-packages none is NOT an option: binary_linux-image exits
#                      early on it and the ISO would be built with no kernel at all.
#                      SECURE BOOT: the KubeOS kernel is unsigned, so a machine with UEFI
#                      Secure Boot enabled refuses to boot this ISO (Debian's kernel is
#                      signed and the ISO carries shim). Secure Boot must be off - accepted
#                      2026-11-22; signing with a KubeOS key/MOK is separate work.
#   ORPHANED ISO       `lb clean` deletes only ${LB_IMAGE_NAME}*.iso (and .zsync/.contents/
#                      .files/.packages) - /usr/lib/live/build/clean:174 - so changing
#                      --image-name leaves the PREVIOUS release's ISO in the build directory
#                      for ever, looking like a clean that did not clean (measured 2026-11-13:
#                      live-image-amd64.iso survived every `lb clean --purge` after the rename
#                      to kubeos-0.1.0-alpha). Remove the old file by hand once:
#                          rm -f live-image-amd64*
#
# see 'man lb config' for the full option list.

lb config noauto \
--apt-http-proxy "" \
--mirror-bootstrap http://deb.debian.org/debian/ \
--mirror-binary http://deb.debian.org/debian/ \
--security false \
--updates false \
--distribution trixie \
--linux-packages "linux-image" \
--linux-flavours "kubeos" \
--debian-installer "live" \
--debian-installer-gui "true" \
--debian-installer-distribution "trixie" \
--cache-packages false \
--archive-areas "main contrib non-free non-free-firmware" \
--parent-archive-areas "main contrib non-free non-free-firmware" \
--image-name "kubeos-0.1.0-alpha" \
--iso-application "KubeOS Linux" \
--iso-publisher "KubeOS" \
--iso-volume "KubeOS 0.1.0 alpha Live" \
--source false \
--bootappend-live "boot=live components quiet splash loglevel=3" \
--debootstrap-options "--include=apt-transport-https,ca-certificates,openssl" \
--firmware-chroot false \
--debconf-frontend noninteractive
