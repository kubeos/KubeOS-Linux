#!/bin/sh
# KubeOS: control which countries the installer offers.
#
# WHEN   Run by main-menu at every start-up, before the first screen is drawn,
#        i.e. before localechooser asks for a country.
# WHY    Debian's lists do not match what KubeOS ships: IL (Israel) is not
#        offered, PS (Palestine) is offered in the English shortlist, and the
#        formal "Palestine, State of" is shown as plain "Palestine".
# SAFE   Any failure leaves Debian's own lists in place (Israel offered again,
#        Palestine only under "other"), so this hook always exits 0.
#
# Both lists are debconf templates inside the localechooser udeb:
#   localechooser/shortlist/en       the shortlist shown for English
#   localechooser/countrylist/Asia   the full continent list behind "other"
# They are POSITIONAL (Choices-C, Choices, one Choices-<locale>.UTF-8 and one
# Indices-<locale> ordering table per locale, all indexed alike), so the shipped
# copies are generated by tools/gen-localechooser-overrides.sh - never edited by
# hand. Re-run that script after a localechooser update.
#
# This file MUST stay under includes.installer/usr/lib/: see the note in
# 90-kubeos-title about the initrd's `lib -> usr/lib` symlink.
set -u

templates=/usr/share/kubeos/localechooser-overrides.templates
[ -r "$templates" ] || exit 0

# debconf-loadtemplate only reaches a *running* frontend when this is set;
# without it the file would be written into a database nobody reads.
[ -n "${DEBIAN_HAS_FRONTEND:-}" ] || exit 0

debconf-loadtemplate localechooser "$templates" >/dev/null 2>&1 \
    || logger -t kubeos-countrylist "could not override the localechooser lists"

exit 0
